# Docker Compose project name (prefix for containers, networks and volumes)
COMPOSE_PROJECT_NAME=lead-pipeline-aws

# Copy this file to .env and replace every "change-me" value.
# .env is git-ignored - never commit real passwords.

# --- Web app ---
# Port on the host mapped to the web container
APP_PORT=8080

# --- MariaDB ---
# Inside Docker Compose, a host name is the service name from compose.yaml
DB_HOST=db
DB_NAME=leads
DB_USER=leadapp
DB_PASS=change-me
# Used only by the MariaDB container to initialise the database on first start
DB_ROOT_PASSWORD=change-me

# --- RabbitMQ ---
# CHECK: variable names must match the code
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=leadapp
RABBITMQ_PASS=change-me

# --- Memcached ---
MC_HOST=memcached

# --- Email (Mailpit catches all mail in the lab) ---
# CHECK: variable names must match the code
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=leads@example.com
MAIL_TO=sales@example.com